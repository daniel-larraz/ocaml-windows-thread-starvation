diff --git a/runtime/platform.c b/runtime/platform.c
index ad27598..627120a 100644
--- a/runtime/platform.c
+++ b/runtime/platform.c
@@ -394,7 +394,11 @@ unsigned caml_plat_spin_back_off(unsigned sleep_nsec,
                 loc->function, loc->file, loc->line);
   }
 #ifdef _WIN32
-  Sleep(sleep_nsec / NSEC_PER_MSEC);
+  /* EXPERIMENT (gasche's suggestion on ocaml/ocaml#15042): do not call
+     Sleep for a back-off shorter than the clock tick, which it cannot
+     honour anyway -- keep spinning instead. */
+  if (sleep_nsec >= 16 * NSEC_PER_MSEC)
+    Sleep(sleep_nsec / NSEC_PER_MSEC);
 #elif defined (HAS_NANOSLEEP)
   const struct timespec req = caml_timespec_of_nsec(sleep_nsec);
   nanosleep(&req, NULL);
